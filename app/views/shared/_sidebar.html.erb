<aside class="fixed inset-y-0 left-0 w-64 bg-white border-r border-gray-100 shadow-sm z-50 flex flex-col">
  <!-- Brand -->
  <div class="h-20 flex items-center px-8 border-b border-gray-50">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-brand-yellow flex items-center justify-center text-brand-charcoal font-bold text-lg">
        B
      </div>
      <span class="text-xl font-bold text-brand-charcoal tracking-tight">Billi</span>
    </div>
  </div>

  <!-- Nav -->
  <nav class="flex-1 px-4 py-8 space-y-2">
    <%= link_to trips_path, class: "flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 group #{current_page?(trips_path) || request.path.start_with?('/trips') ? 'bg-brand-yellow/10 text-brand-charcoal font-bold' : 'text-gray-500 hover:bg-gray-50 hover:text-brand-charcoal'}" do %>
      <svg class="w-5 h-5 <%= current_page?(trips_path) || request.path.start_with?('/trips') ? 'text-brand-charcoal' : 'text-gray-400 group-hover:text-brand-charcoal' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      Trips
    <% end %>

    <%= link_to ledger_path, class: "flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 group #{current_page?(ledger_path) ? 'bg-brand-teal/10 text-brand-teal font-bold' : 'text-gray-500 hover:bg-gray-50 hover:text-brand-charcoal'}" do %>
      <svg class="w-5 h-5 <%= current_page?(ledger_path) ? 'text-brand-teal' : 'text-gray-400 group-hover:text-brand-charcoal' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"></path></svg>
      Ledger
    <% end %>

    <%= link_to friends_path, class: "flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 group #{current_page?(friends_path) ? 'bg-brand-yellow/10 text-brand-charcoal font-bold' : 'text-gray-500 hover:bg-gray-50 hover:text-brand-charcoal'}" do %>
      <svg class="w-5 h-5 <%= current_page?(friends_path) ? 'text-brand-charcoal' : 'text-gray-400 group-hover:text-brand-charcoal' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
      Friends & Billing
    <% end %>
  </nav>

  <!-- Footer / User -->
  <div class="p-4 border-t border-gray-50">
    <div class="flex items-center gap-3 px-2 py-3">
      <div class="w-10 h-10 rounded-full bg-brand-charcoal flex items-center justify-center text-white text-sm font-medium">
        <%= current_user.email[0].upcase %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-brand-charcoal truncate"><%= current_user.name || current_user.email.split('@').first.capitalize %></p>
        <p class="text-xs text-gray-400 truncate">Pro Plan</p>
      </div>
    </div>
  </div>
</aside>
