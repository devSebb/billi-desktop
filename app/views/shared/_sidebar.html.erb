<aside class="fixed inset-y-0 left-0 w-64 bg-billi-surface dark:bg-billi-bg-dark border-r border-billi-ink/10 dark:border-billi-cream/10 shadow-sm z-50 flex flex-col">
  <div class="h-20 flex items-center px-8 border-b border-billi-ink/10 dark:border-billi-cream/10">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-lg bg-brand-yellow flex items-center justify-center text-brand-charcoal font-bold text-lg">
        T
      </div>
      <span class="text-xl font-bold text-primary tracking-tight">Tripstein</span>
    </div>
  </div>

  <!-- Nav -->
  <nav class="flex-1 px-4 py-8 space-y-2">
    <%= link_to trips_path, class: "flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 group #{current_page?(trips_path) || request.path.start_with?('/trips') ? 'bg-brand-yellow/10 dark:bg-brand-yellow/20 text-primary font-bold' : 'text-muted hover:bg-billi-bg dark:hover:bg-billi-surface-dark hover:text-primary'}" do %>
      <svg class="w-5 h-5 <%= current_page?(trips_path) || request.path.start_with?('/trips') ? 'text-primary' : 'text-muted group-hover:text-primary' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      Trips
    <% end %>

    <%= link_to ledger_path, class: "flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 group #{current_page?(ledger_path) ? 'bg-brand-teal/10 dark:bg-brand-teal/20 text-brand-teal font-bold' : 'text-muted hover:bg-billi-bg dark:hover:bg-billi-surface-dark hover:text-primary'}" do %>
      <svg class="w-5 h-5 <%= current_page?(ledger_path) ? 'text-brand-teal' : 'text-muted group-hover:text-primary' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"></path></svg>
      Ledger
    <% end %>

    <%= link_to friends_path, class: "flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 group #{current_page?(friends_path) ? 'bg-brand-yellow/10 dark:bg-brand-yellow/20 text-primary font-bold' : 'text-muted hover:bg-billi-bg dark:hover:bg-billi-surface-dark hover:text-primary'}" do %>
      <svg class="w-5 h-5 <%= current_page?(friends_path) ? 'text-primary' : 'text-muted group-hover:text-primary' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
      Friends & Billing
    <% end %>
  </nav>

  <!-- Footer / User -->
  <div class="p-4 border-t border-billi-ink/10 dark:border-billi-cream/10">
    <%= link_to edit_user_registration_path, class: "flex items-center gap-3 px-2 py-3 rounded-lg hover:bg-billi-bg dark:hover:bg-billi-surface-dark transition-colors group" do %>
      <%= user_avatar(current_user, classes: "w-10 h-10 text-sm") %>
      <div class="flex-1 min-w-0 text-left">
        <p class="text-sm font-medium text-primary truncate group-hover:text-brand-yellow transition-colors"><%= current_user.name || current_user.email.split('@').first.capitalize %></p>
        <p class="text-xs text-muted truncate">View Profile</p>
      </div>
      <svg class="w-4 h-4 text-muted group-hover:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <% end %>
  </div>
</aside>
