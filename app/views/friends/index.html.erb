<% content_for :header_title, "Friends & Billing" %>

<div class="max-w-6xl mx-auto">
  <!-- Filter -->
  <div class="flex justify-between items-center mb-8">
    <div class="relative inline-block text-left">
      <%= form_with url: friends_path, method: :get, class: "flex items-center gap-4" do |f| %>
        <label class="text-sm font-medium text-muted">Trip:</label>
        <% if @trips.any? %>
          <%= f.select :trip_id, options_from_collection_for_select(@trips, :id, :name, @selected_trip&.id), {}, onchange: "this.form.submit()", class: "input w-auto min-w-[200px] py-2.5" %>
        <% else %>
          <span class="text-muted">No trips available</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @selected_trip %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Balances -->
      <div class="space-y-6">
        <h3 class="section-title">Balances</h3>
        <div class="card p-0 overflow-hidden">
           <% if @balances.present? %>
             <div class="divide-y divide-gray-100">
               <% @balances.each do |b| %>
                 <div class="p-6 flex items-center justify-between">
                   <div class="flex items-center gap-4">
                      <div class="w-10 h-10 rounded-full bg-billi-bg-muted dark:bg-gray-700 flex items-center justify-center font-bold text-muted">
                        <%= b[:participant].name&.first&.upcase || "?" %>
                      </div>
                      <div>
                        <div class="font-bold text-primary"><%= b[:participant].name %></div>
                        <div class="text-xs text-muted">Paid <%= number_to_currency(b[:paid]) %></div>
                      </div>
                   </div>
                   
                   <div class="text-right">
                     <% if b[:balance] > 0.01 %>
                       <div class="text-green-500 font-bold">+<%= number_to_currency(b[:balance]) %></div>
                       <div class="text-xs text-green-600/70">gets back</div>
                     <% elsif b[:balance] < -0.01 %>
                       <div class="text-red-500 font-bold"><%= number_to_currency(b[:balance]) %></div>
                       <div class="text-xs text-red-600/70">owes</div>
                     <% else %>
                       <div class="text-muted font-bold">Settled</div>
                     <% end %>
                   </div>
                 </div>
               <% end %>
             </div>
           <% else %>
             <div class="p-8 text-center text-muted">
               No participants or expenses yet.
             </div>
           <% end %>
        </div>
      </div>

      <!-- Settlement -->
      <div class="space-y-6">
        <h3 class="section-title">Settlement Plan</h3>
        <div class="card bg-brand-charcoal dark:bg-billi-surface-dark border-0 text-billi-cream p-6">
           <% if @settlements.present? %>
             <div class="space-y-4">
               <% @settlements.each do |s| %>
                 <div class="flex items-center justify-between bg-white/5 p-4 rounded-xl border border-white/10">
                    <div class="flex items-center gap-2">
                      <span class="font-bold"><%= s[:from] %></span>
                      <span class="text-billi-cream-muted text-sm">pays</span>
                      <span class="font-bold"><%= s[:to] %></span>
                    </div>
                    <div class="font-bold text-brand-yellow">
                      <%= number_to_currency(s[:amount]) %>
                    </div>
                 </div>
               <% end %>
             </div>
             <div class="mt-6 pt-6 border-t border-white/10 text-center">
               <button class="text-sm text-brand-teal hover:text-white transition-colors font-medium">Copy summary</button>
             </div>
           <% else %>
             <div class="text-center py-12 text-muted">
               Nothing to settle. Everyone is all square!
             </div>
           <% end %>
        </div>
      </div>
      
    </div>
  <% else %>
    <div class="text-center py-24 text-muted">
      Please select a trip.
    </div>
  <% end %>
</div>

