<% content_for :header_title, "Plan a new trip" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-8">
    <div class="flex items-center gap-4 text-sm font-medium text-gray-400">
      <span class="text-brand-charcoal">1. Destination & Dates</span>
      <div class="w-8 h-px bg-gray-200"></div>
      <span>2. Preferences</span>
      <div class="w-8 h-px bg-gray-200"></div>
      <span>3. Budget</span>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow-sm p-8">
    <%= form_with(model: @trip, local: true, class: "space-y-6") do |f| %>
      
      <% if @trip.errors.any? %>
        <div class="bg-red-50 text-red-700 p-4 rounded-lg mb-6">
          <ul class="list-disc pl-5">
            <% @trip.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Name -->
      <div>
        <%= f.label :name, "Trip Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full rounded-xl border-gray-200 focus:border-brand-yellow focus:ring-brand-yellow placeholder-gray-300", placeholder: "e.g. Summer in Italy" %>
      </div>

      <!-- Destination -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :destination_city, "City", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :destination_city, class: "w-full rounded-xl border-gray-200 focus:border-brand-yellow focus:ring-brand-yellow placeholder-gray-300", placeholder: "e.g. Rome" %>
        </div>
        <div>
          <%= f.label :destination_country, "Country", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :destination_country, class: "w-full rounded-xl border-gray-200 focus:border-brand-yellow focus:ring-brand-yellow placeholder-gray-300", placeholder: "e.g. Italy" %>
        </div>
      </div>

      <!-- Dates -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :start_date, "Start Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :start_date, class: "w-full rounded-xl border-gray-200 focus:border-brand-yellow focus:ring-brand-yellow placeholder-gray-300" %>
        </div>
        <div>
          <%= f.label :end_date, "End Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :end_date, class: "w-full rounded-xl border-gray-200 focus:border-brand-yellow focus:ring-brand-yellow placeholder-gray-300" %>
        </div>
      </div>

      <!-- Travelers -->
      <div>
        <%= f.label :travelers_count, "Number of People", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :travelers_count, value: 1, min: 1, class: "w-full rounded-xl border-gray-200 focus:border-brand-yellow focus:ring-brand-yellow placeholder-gray-300" %>
      </div>
      
      <!-- Currency (Hidden for now default USD or select) -->
      <%= f.hidden_field :currency, value: "USD" %>

      <div class="pt-6 flex items-center justify-end gap-4">
        <%= link_to "Cancel", trips_path, class: "text-gray-500 hover:text-brand-charcoal font-medium" %>
        <%= f.submit "Next: Preferences", class: "btn-primary cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
