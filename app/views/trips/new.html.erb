<% content_for :header_title, "Plan a new trip" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-8">
    <div class="flex items-center gap-4 text-sm font-medium text-muted">
      <span class="text-primary">1. Destination & Dates</span>
      <div class="w-8 h-px bg-billi-ink/20 dark:bg-billi-cream/20"></div>
      <span>2. Preferences</span>
      <div class="w-8 h-px bg-gray-200 dark:bg-gray-600"></div>
      <span>3. Budget</span>
    </div>
  </div>

  <div class="card p-8">
    <%= form_with(model: @trip, local: true, class: "section space-y-6") do |f| %>
      <% if @trip.errors.any? %>
        <div class="p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800 text-red-700 dark:text-red-300 text-sm">
          <ul class="list-disc pl-5">
            <% @trip.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Trip Name", class: "label" %>
        <%= f.text_field :name, class: "input", placeholder: "e.g. Summer in Italy" %>
      </div>

      <div>
        <%= f.label :city_id, "Destination", class: "label" %>
        <%= f.select :city_id, options_from_collection_for_select(@cities || [], :id, :name, @trip.destination_city.present? ? City.find_by(name: @trip.destination_city, country: @trip.destination_country)&.id : nil), { include_blank: "— Select a city —" }, { class: "input", required: true } %>
        <p class="help-text">Select from supported cities for accurate pricing.</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :start_date, "Start Date", class: "label" %>
          <%= f.date_field :start_date, class: "input" %>
        </div>
        <div>
          <%= f.label :end_date, "End Date", class: "label" %>
          <%= f.date_field :end_date, class: "input" %>
        </div>
      </div>

      <div>
        <%= f.label :travelers_count, "Number of People", class: "label" %>
        <%= f.number_field :travelers_count, value: 1, min: 1, class: "input" %>
      </div>

      <%= f.hidden_field :currency, value: "USD" %>

      <div class="pt-6 flex items-center justify-end gap-4">
        <%= link_to "Cancel", trips_path, class: "btn-ghost" %>
        <%= f.submit "Next: Preferences", class: "btn-primary cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
