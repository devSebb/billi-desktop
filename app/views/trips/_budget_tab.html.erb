<div class="bg-white rounded-2xl shadow-sm p-8">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-bold text-brand-charcoal">Budget Preferences</h2>
    <%= link_to "Edit Preferences", wizard_step_2_trip_path(trip), class: "text-brand-yellow font-medium hover:text-yellow-600" %>
  </div>

  <div class="space-y-4">
    <!-- Lodging -->
    <div class="p-6 border border-gray-100 rounded-xl bg-gray-50/50">
       <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-3 font-medium text-brand-charcoal text-lg">
            <span class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-sm">🏨</span> 
            Lodging
          </div>
          <span class="font-bold text-xl text-brand-charcoal"><%= number_to_currency(budget&.lodging_total, precision: 0) %></span>
       </div>
       <div class="pl-11 text-gray-500">
         <span class="font-medium text-brand-charcoal"><%= preference.lodging_style.titleize %></span> style. 
         Includes <strong class="text-brand-charcoal"><%= preference.hotel_nights %></strong> hotel nights and <strong class="text-brand-charcoal"><%= preference.airbnb_nights %></strong> Airbnb nights.
       </div>
    </div>

    <!-- Food -->
    <div class="p-6 border border-gray-100 rounded-xl bg-gray-50/50">
       <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-3 font-medium text-brand-charcoal text-lg">
            <span class="w-8 h-8 rounded-lg bg-orange-100 text-orange-600 flex items-center justify-center text-sm">🍽</span> 
            Food & Dining
          </div>
          <span class="font-bold text-xl text-brand-charcoal"><%= number_to_currency(budget&.restaurants_total, precision: 0) %></span>
       </div>
       <div class="pl-11 text-gray-500">
         <strong class="text-brand-charcoal"><%= preference.fancy_restaurant_meals %></strong> fancy meals, 
         <strong class="text-brand-charcoal"><%= preference.casual_restaurant_meals %></strong> casual meals, 
         <strong class="text-brand-charcoal"><%= preference.street_food_meals %></strong> street food meals.
       </div>
    </div>

    <!-- Activities -->
    <div class="p-6 border border-gray-100 rounded-xl bg-gray-50/50">
       <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-3 font-medium text-brand-charcoal text-lg">
            <span class="w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center text-sm">🎉</span> 
            Activities
          </div>
          <span class="font-bold text-xl text-brand-charcoal"><%= number_to_currency(budget&.activities_total, precision: 0) %></span>
       </div>
       <div class="pl-11 text-gray-500">
         <strong class="text-brand-charcoal"><%= preference.activities_count %></strong> paid activities planned.
       </div>
    </div>

    <!-- Nightlife -->
    <div class="p-6 border border-gray-100 rounded-xl bg-gray-50/50">
       <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-3 font-medium text-brand-charcoal text-lg">
            <span class="w-8 h-8 rounded-lg bg-pink-100 text-pink-600 flex items-center justify-center text-sm">🍷</span> 
            Nightlife
          </div>
          <span class="font-bold text-xl text-brand-charcoal"><%= number_to_currency(budget&.drinks_total, precision: 0) %></span>
       </div>
       <div class="pl-11 text-gray-500">
         <strong class="text-brand-charcoal"><%= preference.nightlife_nights %></strong> nights out.
       </div>
    </div>
    
    <!-- Shopping -->
    <div class="p-6 border border-gray-100 rounded-xl bg-gray-50/50">
       <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-3 font-medium text-brand-charcoal text-lg">
            <span class="w-8 h-8 rounded-lg bg-yellow-100 text-yellow-600 flex items-center justify-center text-sm">🛍</span> 
            Shopping
          </div>
          <span class="font-bold text-xl text-brand-charcoal"><%= number_to_currency(budget&.shopping_total, precision: 0) %></span>
       </div>
       <div class="pl-11 text-gray-500">
         Budget level: <strong class="text-brand-charcoal capitalize"><%= preference.shopping_budget_level %></strong>.
       </div>
    </div>
  </div>
</div>

