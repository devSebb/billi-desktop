<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Edit Trip Details</h1>

  <%= form_with(model: @trip, local: true, class: "space-y-6") do |f| %>
    <% if @trip.errors.any? %>
      <div class="bg-red-50 p-4 rounded-lg mb-6">
        <ul class="list-disc list-inside text-red-600 text-sm">
          <% @trip.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Trip Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, placeholder: "e.g. Summer in Tokyo", class: "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :destination_city, "City", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :destination_city, class: "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :destination_country, "Country", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :destination_country, class: "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :start_date, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :start_date, class: "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :end_date, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :end_date, class: "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :travelers_count, "How many people?", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :travelers_count, min: 1, class: "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
      <div>
        <%= f.label :currency, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :currency, ["USD", "EUR", "GBP", "BRL"], {}, class: "w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
    </div>

    <div class="pt-6 flex gap-4">
      <%= f.submit "Update Trip", class: "bg-indigo-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-indigo-700 transition cursor-pointer" %>
      <%= link_to "Cancel", trip_path(@trip), class: "bg-white text-gray-700 px-6 py-3 rounded-lg border border-gray-300 font-medium hover:bg-gray-50 transition" %>
    </div>
  <% end %>
  
  <div class="mt-12 pt-8 border-t border-gray-200">
     <h3 class="text-lg font-medium text-red-600 mb-4">Danger Zone</h3>
     <%= button_to "Delete Trip", trip_path(@trip), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-red-600 border border-red-200 bg-red-50 px-4 py-2 rounded hover:bg-red-100 transition" %>
  </div>
</div>

