<div class="max-w-2xl mx-auto">
  <h1 class="section-title mb-8">Edit Trip Details</h1>

  <div class="card p-8 mb-8">
    <%= form_with(model: @trip, local: true, class: "section space-y-6") do |f| %>
      <% if @trip.errors.any? %>
        <div class="p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800 text-red-700 dark:text-red-300 text-sm">
          <ul class="list-disc list-inside">
            <% @trip.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Trip Name", class: "label" %>
        <%= f.text_field :name, placeholder: "e.g. Summer in Tokyo", class: "input" %>
      </div>

      <div>
        <%= f.label :city_id, "Destination", class: "label" %>
        <%= f.select :city_id, options_from_collection_for_select(@cities || [], :id, :name, City.find_by(name: @trip.destination_city, country: @trip.destination_country)&.id), { include_blank: "— Select a city —" }, { class: "input" } %>
        <p class="help-text">Reselect to fix destination or get updated pricing.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :start_date, class: "label" %>
          <%= f.date_field :start_date, class: "input" %>
        </div>
        <div>
          <%= f.label :end_date, class: "label" %>
          <%= f.date_field :end_date, class: "input" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :travelers_count, "How many people?", class: "label" %>
          <%= f.number_field :travelers_count, min: 1, class: "input" %>
        </div>
        <div>
          <%= f.label :currency, class: "label" %>
          <%= f.select :currency, ["USD", "EUR", "GBP", "BRL"], {}, class: "input" %>
        </div>
      </div>

      <div class="pt-6 flex gap-4">
        <%= f.submit "Update Trip", class: "btn-primary cursor-pointer" %>
        <%= link_to "Cancel", trip_path(@trip), class: "btn-secondary" %>
      </div>
    <% end %>
  </div>

  <div class="pt-8 border-t border-gray-200 dark:border-gray-700">
    <h3 class="card-title text-red-600 dark:text-red-400 mb-4">Danger Zone</h3>
    <%= button_to "Delete Trip", trip_path(@trip), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn-danger cursor-pointer" %>
  </div>
</div>

