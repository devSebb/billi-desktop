<div class="max-w-2xl mx-auto">
  <div class="mb-8">
    <h1 class="section-title">Account Settings</h1>
    <p class="text-muted mt-1">Manage your profile and security preferences.</p>
  </div>

  <div class="card border border-gray-100 dark:border-gray-700 overflow-hidden p-0">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "divide-y divide-gray-100 dark:divide-gray-700", multipart: true }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="p-8">
        <h2 class="card-title mb-4">Profile</h2>
        <div class="flex items-start gap-6">
          <div class="flex-shrink-0">
            <%= user_avatar(resource, classes: "w-24 h-24 text-3xl") %>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <%= f.label :avatar, "Profile Photo", class: "label" %>
              <%= f.file_field :avatar, class: "block w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-brand-yellow/10 file:text-primary hover:file:bg-brand-yellow/20 dark:file:bg-brand-yellow/20 dark:file:text-primary transition-colors cursor-pointer" %>
              <p class="help-text">JPG, GIF or PNG. Max 1MB.</p>
            </div>
            <div>
              <%= f.label :name, "Full Name", class: "label" %>
              <%= f.text_field :name, class: "input", placeholder: "Your name" %>
            </div>
            <div>
              <%= f.label :email, "Email Address", class: "label" %>
              <%= f.email_field :email, autocomplete: "email", class: "input" %>
            </div>
            <div>
              <%= f.label :display_currency, "Display currency", class: "label" %>
              <%= f.select :display_currency, [["USD", "USD"], ["EUR", "EUR"], ["GBP", "GBP"], ["BRL", "BRL"]], {}, class: "input" %>
              <p class="help-text">Amounts will be shown in this currency when a rate is available.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="p-8">
        <h2 class="card-title mb-4">Security</h2>
        <div class="space-y-4 max-w-md">
          <div>
            <%= f.label :password, "New Password", class: "label" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "input", placeholder: "Leave blank to keep current" %>
            <% if @minimum_password_length %>
              <p class="help-text"><%= @minimum_password_length %> characters minimum</p>
            <% end %>
          </div>
          <div>
            <%= f.label :password_confirmation, "Confirm New Password", class: "label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
          </div>
        </div>
      </div>

      <div class="p-8 bg-billi-bg dark:bg-billi-surface-dark/80">
        <div class="max-w-md">
          <%= f.label :current_password, "Current Password", class: "label" %>
          <p class="help-text mb-2">We need your current password to confirm your changes.</p>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "input" %>
        </div>
        <div class="mt-6 flex justify-end">
          <%= f.submit "Save Changes", class: "btn-primary cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-8 p-8 rounded-2xl border border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/20">
    <h3 class="card-title text-red-800 dark:text-red-300 mb-2">Danger Zone</h3>
    <p class="text-sm text-red-600 dark:text-red-400 mb-4">Once you delete your account, there is no going back. Please be certain.</p>
    <%= button_to "Delete my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "btn-danger cursor-pointer" %>
  </div>
</div>

