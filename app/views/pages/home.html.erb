<%# Landing page — cinematic, scroll-led story %>
<%# Load Cabinet Grotesk display font (landing only, via Fontshare CDN) %>
<% content_for :head do %>
  <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
  <link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@700,900&display=swap" rel="stylesheet">
  <style>html { scroll-behavior: smooth; }</style>
<% end %>

<%# Force-light landing wrapper (prevents dark mode inheritance) %>
<div class="landing">
  <%# Scroll progress bar %>
  <div class="landing-progress-bar" id="scroll-progress" style="transform: scaleX(0);"></div>

  <%# Section A: Glass Navbar %>
  <%= render "pages/home/nav" %>

  <%# Section B: Cinematic Hero %>
  <%= render "pages/home/hero" %>

  <%# Section C: Trust Bar %>
  <%= render "pages/home/trust_bar" %>

  <%# Section D: Product Story Walkthrough %>
  <%= render "pages/home/walkthrough" %>

  <%# Section E: Feature Showcase %>
  <%= render "pages/home/features" %>

  <%# Section F: City Explorer (Unsplash-powered) %>
  <%= render "pages/home/city_explorer" %>

  <%# Section G: Social Proof / Use Cases %>
  <%= render "pages/home/social_proof" %>

  <%# Section H: Final CTA %>
  <%= render "pages/home/final_cta" %>

  <%# Section I: Footer %>
  <%= render "pages/home/footer" %>
</div>

<%# Scroll progress bar script (lightweight, no Stimulus needed) %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var bar = document.getElementById('scroll-progress');
    if (!bar) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      bar.style.display = 'none';
      return;
    }
    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(function() {
          var scrollTop = window.scrollY;
          var docHeight = document.documentElement.scrollHeight - window.innerHeight;
          var progress = docHeight > 0 ? scrollTop / docHeight : 0;
          bar.style.transform = 'scaleX(' + progress + ')';
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  });
</script>
