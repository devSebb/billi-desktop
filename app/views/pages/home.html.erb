<!-- How it works -->
<section class="bg-brand-charcoal py-24 relative overflow-hidden">
  <div class="max-w-screen-xl px-4 mx-auto relative z-10">
     <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-4">From idea to itinerary in minutes.</h2>
        <p class="text-gray-400 max-w-xl mx-auto text-lg">Billi handles the math so you can focus on the memories.</p>
     </div>

     <div class="grid md:grid-cols-3 gap-12">
        <!-- Step 1 -->
        <div class="text-center group">
           <div class="w-20 h-20 mx-auto bg-brand-yellow rounded-2xl border-2 border-white shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] flex items-center justify-center text-3xl mb-8 group-hover:scale-110 transition-transform duration-300 transform -rotate-3">📍</div>
           <h3 class="text-xl font-bold text-white mb-3">1. Pick a Destination</h3>
           <p class="text-gray-400 leading-relaxed">Choose where and when. We support major cities worldwide with localized pricing data.</p>
        </div>

        <!-- Step 2 -->
        <div class="text-center group">
           <div class="w-20 h-20 mx-auto bg-brand-teal rounded-2xl border-2 border-white shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] flex items-center justify-center text-3xl mb-8 group-hover:scale-110 transition-transform duration-300 transform rotate-3">🎚️</div>
           <h3 class="text-xl font-bold text-white mb-3">2. Tune Preferences</h3>
           <p class="text-gray-400 leading-relaxed">Luxury hotel or cozy Airbnb? Fine dining or street food? Adjust sliders to match your vibe.</p>
        </div>

        <!-- Step 3 -->
        <div class="text-center group">
           <div class="w-20 h-20 mx-auto bg-white rounded-2xl border-2 border-brand-yellow shadow-[4px_4px_0px_0px_#F7B500] flex items-center justify-center text-3xl mb-8 group-hover:scale-110 transition-transform duration-300 transform -rotate-1">👯‍♀️</div>
           <h3 class="text-xl font-bold text-white mb-3">3. Share & Split</h3>
           <p class="text-gray-400 leading-relaxed">Invite friends, track who paid for what, and settle up effortlessly.</p>
        </div>
     </div>
  </div>
</section>

