<%# Footer — brand reinforcement, columns, micro-delight %>
<footer style="background: var(--color-landing-charcoal); border-top: 1px solid rgba(255,255,255,0.05);">
  <div class="max-w-screen-xl mx-auto px-6 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-16">
      <%# Brand column %>
      <div class="col-span-2 md:col-span-1">
        <a href="#" class="flex items-center gap-3 mb-5">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-lg"
               style="background: var(--color-landing-saffron); color: var(--color-landing-charcoal);">T</div>
          <span class="text-xl font-bold text-white">Tripstein</span>
        </a>
        <p class="text-sm leading-relaxed" style="color: rgba(255,255,255,0.4);">
          Travel budget planning, powered by real-world data. Built for travelers who hate spreadsheets.
        </p>
      </div>

      <%# Product column %>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider mb-4" style="color: rgba(255,255,255,0.3);">Product</h4>
        <ul class="space-y-3">
          <li><a href="#features" class="text-sm transition-colors duration-200 hover:text-white" style="color: rgba(255,255,255,0.6);">Features</a></li>
          <li><a href="#cities" class="text-sm transition-colors duration-200 hover:text-white" style="color: rgba(255,255,255,0.6);">Cities</a></li>
          <li><a href="#how-it-works" class="text-sm transition-colors duration-200 hover:text-white" style="color: rgba(255,255,255,0.6);">How it works</a></li>
        </ul>
      </div>

      <%# Company column %>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider mb-4" style="color: rgba(255,255,255,0.3);">Company</h4>
        <ul class="space-y-3">
          <li><a href="#" class="text-sm transition-colors duration-200 hover:text-white" style="color: rgba(255,255,255,0.6);">About</a></li>
          <li><a href="#" class="text-sm transition-colors duration-200 hover:text-white" style="color: rgba(255,255,255,0.6);">Privacy</a></li>
          <li><a href="#" class="text-sm transition-colors duration-200 hover:text-white" style="color: rgba(255,255,255,0.6);">Terms</a></li>
        </ul>
      </div>

      <%# Connect column %>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider mb-4" style="color: rgba(255,255,255,0.3);">Connect</h4>
        <ul class="space-y-3">
          <li><a href="#" class="text-sm transition-colors duration-200 hover:text-white" style="color: rgba(255,255,255,0.6);">Twitter / X</a></li>
          <li><a href="#" class="text-sm transition-colors duration-200 hover:text-white" style="color: rgba(255,255,255,0.6);">GitHub</a></li>
          <li><a href="mailto:hello@tripstein.app" class="text-sm transition-colors duration-200 hover:text-white" style="color: rgba(255,255,255,0.6);">Email</a></li>
        </ul>
      </div>
    </div>

    <%# Bottom bar %>
    <div class="mt-16 pt-8 flex flex-col md:flex-row items-center justify-between gap-4"
         style="border-top: 1px solid rgba(255,255,255,0.06);">
      <p class="text-xs" style="color: rgba(255,255,255,0.3);">
        &copy; <%= Time.current.year %> Tripstein. Travel smarter.
      </p>
      <p class="text-xs" style="color: rgba(255,255,255,0.25);">
        Made with <span class="sun-pulse">&#9728;&#65039;</span> for travelers who hate spreadsheets.
      </p>
    </div>
  </div>
</footer>
