<%# Social Proof / Use Cases — who Billi is built for %>
<section class="relative py-24 lg:py-32"
         style="background: white;">
  <div class="max-w-screen-xl mx-auto px-6">
    <%# Section header %>
    <div class="text-center mb-16" data-controller="scroll-reveal">
      <span class="reveal-fade-up inline-flex items-center px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-6"
            data-reveal-delay="0"
            style="background: rgba(236,72,153,0.1); color: #EC4899;">
        For every traveler
      </span>
      <h2 class="reveal-fade-up landing-headline-secondary text-3xl md:text-4xl lg:text-5xl mb-5"
          data-reveal-delay="80"
          style="color: var(--color-landing-charcoal);">
        However you travel, Tripstein gets it.
      </h2>
    </div>

    <%# Use-case vignettes %>
    <div class="grid md:grid-cols-3 gap-8" data-controller="scroll-reveal">
      <% [
        {
          icon: "🎒",
          title: "Solo in Lisbon",
          desc: "You're planning 2 weeks in Portugal. Tripstein gives you a day-by-day budget based on real Lisbon prices — hostels, meals, transit, all of it.",
          color: "var(--color-landing-saffron)",
          bg: "rgba(245,166,35,0.06)",
          delay: "0"
        },
        {
          icon: "💑",
          title: "Couple in Tokyo",
          desc: "You and your partner want to experience Tokyo without breaking the bank. Tripstein splits everything per-person and shows where to save.",
          color: "var(--color-landing-teal)",
          bg: "rgba(14,165,165,0.06)",
          delay: "100"
        },
        {
          icon: "👯",
          title: "Friends in Mexico City",
          desc: "Four friends, one trip, a shared budget. Tripstein tracks who paid for what and settles up at the end. No awkward Venmo requests.",
          color: "#6366F1",
          bg: "rgba(99,102,241,0.06)",
          delay: "200"
        }
      ].each do |usecase| %>
        <div class="reveal-fade-up rounded-2xl p-8 transition-all duration-300 hover:shadow-lg group"
             data-reveal-delay="<%= usecase[:delay] %>"
             style="background: <%= usecase[:bg] %>; border: 1px solid rgba(26,31,37,0.04);">
          <div class="text-4xl mb-5"><%= usecase[:icon] %></div>
          <h3 class="text-lg font-bold mb-3 tracking-tight-landing"
              style="color: var(--color-landing-charcoal);">
            <%= usecase[:title] %>
          </h3>
          <p class="text-sm leading-relaxed" style="color: var(--color-landing-ink-muted);">
            <%= usecase[:desc] %>
          </p>
          <div class="mt-5 flex items-center gap-2 text-sm font-medium transition-colors duration-200"
               style="color: <%= usecase[:color] %>;">
            <span>See how</span>
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
            </svg>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
