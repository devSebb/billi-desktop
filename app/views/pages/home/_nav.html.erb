<%# Landing Navbar — transparent over hero, glass on scroll %>
<nav data-controller="navbar-glass mobile-menu"
     data-navbar-glass-sentinel-value="#hero-sentinel"
     class="landing-nav is-transparent fixed w-full z-50 top-0">
  <div class="max-w-screen-xl mx-auto px-6 py-4 flex items-center justify-between">
    <%# Logo %>
    <a href="#" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-xl flex items-center justify-center font-bold text-lg transition-transform duration-300 group-hover:rotate-0 -rotate-3"
           style="background-color: var(--color-landing-charcoal); color: var(--color-landing-saffron);">T</div>
      <span class="text-xl font-bold" style="color: var(--color-landing-charcoal);">Tripstein</span>
    </a>

    <%# Desktop nav links (scroll anchors) %>
    <div class="hidden md:flex items-center gap-8">
      <a href="#how-it-works" class="text-sm font-medium transition-colors duration-200 hover:opacity-70"
         style="color: var(--color-landing-charcoal);">How it works</a>
      <a href="#features" class="text-sm font-medium transition-colors duration-200 hover:opacity-70"
         style="color: var(--color-landing-charcoal);">Features</a>
      <a href="#cities" class="text-sm font-medium transition-colors duration-200 hover:opacity-70"
         style="color: var(--color-landing-charcoal);">Cities</a>
    </div>

    <%# Desktop CTAs %>
    <div class="hidden md:flex items-center gap-4">
      <%= link_to "Log in", new_user_session_path,
          class: "text-sm font-medium transition-colors duration-200 hover:opacity-70",
          style: "color: var(--color-landing-charcoal);" %>
      <%= link_to "Start free", new_user_registration_path,
          class: "landing-cta-primary text-sm !px-6 !py-2.5" %>
    </div>

    <%# Mobile hamburger %>
    <button class="md:hidden p-2 -mr-2" data-action="mobile-menu#toggle" aria-label="Toggle menu">
      <svg data-mobile-menu-target="openIcon" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg data-mobile-menu-target="closeIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <%# Mobile full-screen overlay %>
  <div data-mobile-menu-target="panel" class="hidden fixed inset-0 top-0 z-40 flex flex-col pt-24 px-8 pb-8"
       style="background-color: var(--color-landing-charcoal);">
    <div class="flex flex-col gap-6 flex-1">
      <a href="#how-it-works" data-action="click->mobile-menu#close"
         class="text-2xl font-bold text-white/90 hover:text-white transition-colors">How it works</a>
      <a href="#features" data-action="click->mobile-menu#close"
         class="text-2xl font-bold text-white/90 hover:text-white transition-colors">Features</a>
      <a href="#cities" data-action="click->mobile-menu#close"
         class="text-2xl font-bold text-white/90 hover:text-white transition-colors">Cities</a>
      <hr class="border-white/10 my-4">
      <%= link_to "Log in", new_user_session_path,
          class: "text-lg font-medium text-white/70 hover:text-white transition-colors" %>
    </div>
    <div class="mt-auto">
      <%= link_to new_user_registration_path,
          class: "block w-full text-center font-bold rounded-full py-4 text-lg transition-colors",
          style: "background-color: var(--color-landing-saffron); color: var(--color-landing-charcoal);" do %>
        Start planning — it's free
      <% end %>
    </div>
  </div>
</nav>
