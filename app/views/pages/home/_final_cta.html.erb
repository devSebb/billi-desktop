<%# Final CTA — dark, warm, premium closer %>
<section class="relative py-24 lg:py-32 overflow-hidden landing-grain"
         style="background: var(--color-landing-charcoal);">
  <%# Subtle teal radial glow %>
  <div class="absolute inset-0 pointer-events-none"
       style="background: radial-gradient(ellipse 50% 50% at 50% 60%, rgba(14,165,165,0.08) 0%, transparent 70%);"></div>

  <div class="relative z-10 max-w-screen-xl mx-auto px-6 text-center" data-controller="scroll-reveal">
    <h2 class="reveal-fade-up landing-headline text-3xl md:text-4xl lg:text-[3.5rem] text-white mb-6"
        data-reveal-delay="0">
      Your next trip deserves a plan.
    </h2>
    <p class="reveal-fade-up text-lg md:text-xl mb-10 max-w-lg mx-auto"
       data-reveal-delay="80"
       style="color: rgba(255,255,255,0.6);">
      Start building your travel budget in under 2 minutes. Free, forever.
    </p>
    <div class="reveal-fade-up" data-reveal-delay="160">
      <%= link_to new_user_registration_path,
          class: "inline-flex items-center justify-center font-bold rounded-full px-10 py-4 text-lg transition-all duration-300 hover:scale-[1.03] group",
          style: "background: var(--color-landing-saffron); color: var(--color-landing-charcoal); box-shadow: 0 8px 30px rgba(245,166,35,0.25);" do %>
        Start planning — it's free
        <svg class="w-5 h-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      <% end %>
    </div>
    <p class="reveal-fade-up text-sm mt-6"
       data-reveal-delay="240"
       style="color: rgba(255,255,255,0.35);">
      No credit card required. No spreadsheets. Just better travel.
    </p>
  </div>
</section>
